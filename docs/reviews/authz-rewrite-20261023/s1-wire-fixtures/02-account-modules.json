          "subject": {
            "id": 41,
            "username": "alice",
            "display_name": "示例甲",
            "role": "sales",
            "salesperson_name": "示例销售",
            "is_active": true
          },
          "authorization_epoch": 7,
          "template": {
            "code": "sales_team",
            "version": 2,
            "current_version": 3,
            "stale": true
          },
          "customer_assignments": {
            "ids": [
              7001,
              7002
            ],
            "customers": [
              {
                "id": 7001,
                "name": "示例客户7001",
                "raw_name": "示例客户7001"
              },
              {
                "id": 7002,
                "name": "示例客户7002",
                "raw_name": "示例客户7002"
              }
            ]
          },
          "resources": {
            "sales_analysis": {
              "version": 3,
              "configuration": {
                "actions": [
                  "read"
                ],
                "scope": "assigned_customers",
                "field_permissions": []
              },
              "source": "personal_override",
              "template_snapshot": {
                "code": "sales_team",
                "version": 2,
                "configuration": {
                  "actions": [
                    "read"
                  ],
                  "scope": "assigned_customers",
                  "field_permissions": []
                }
              },
              "personal_override": {
                "present": true,
                "configuration": {
                  "actions": [
                    "read"
                  ],
                  "scope": "assigned_customers",
                  "field_permissions": []
                }
              }
            },
            "purchase_analysis": {
              "version": 0,
              "configuration": null,
              "source": "none",
              "template_snapshot": {
                "code": "sales_team",
                "version": 2,
                "configuration": null
              },
              "personal_override": {
                "present": false,
                "configuration": null
              }
            },
            "retired_pool_rebuild": {
              "version": 0,
              "configuration": null,
              "source": "none",
              "template_snapshot": {
                "code": "sales_team",
                "version": 2,
                "configuration": null
              },
              "personal_override": {
                "present": false,
                "configuration": null
              }
            }
          }
        }
      },
      "assertions": [
        "effective配置等于保存snapshot仍present=true。",
        "template当前v3但账号保存v2。"
