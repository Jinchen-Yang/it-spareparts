{
  "fixture_format": 1,
  "catalog_version": "authz-s1-v1",
  "note": "Independent DTO examples only; not complete database seeds or reproducible server fingerprint vectors; no live data.",
  "cases": [
    {
      "id": "stale_epoch_zero_changes",
      "request": {
        "method": "PUT",
        "path": "/api/authz/users/alice/modules",
        "json": {
          "schema_version": 1,
          "catalog_version": "authz-s1-v1",
          "expected_epoch": 7,
          "updates": [
            {
              "resource_id": "sales_analysis",
              "expected_version": 3,
              "operation": "replace_resource",
              "configuration": {
                "actions": [
                  "read"
                ],
                "scope": "assigned_customers",
                "field_permissions": []
              }
            }
          ]
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "Cache-Control": "no-store"
        },
        "json": {
          "detail": {
            "code": "AUTHZ_EPOCH_CONFLICT",
            "message": "账号授权已变化，请重新载入",
            "committed": false,
            "conflicts": [
              {
                "kind": "epoch",
                "user_id": 41,
                "expected": 7,
                "actual": 8
              }
            ],
            "field_errors": []
          }
        }
      },
      "assertions": [
        "所有Grant/profile/客户关系不变。"
      ]
    },
