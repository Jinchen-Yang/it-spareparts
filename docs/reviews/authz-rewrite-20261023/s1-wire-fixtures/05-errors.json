    {
      "id": "planned_resource_rejects_entire_account_creation",
      "request": {
        "method": "POST",
        "path": "/api/accounts",
        "json": {
          "schema_version": 1,
          "catalog_version": "authz-s1-v1",
          "profile": {
            "username": "must_not_exist",
            "password": "Fixture-only-password-04!"
          },
          "authorization": {
            "kind": "explicit",
            "modules": {
              "purchase_analysis": {
                "actions": [
                  "read"
                ],
                "scope": "all",
                "field_permissions": []
              }
            }
          }
        }
      },
      "response": {
        "status": 422,
        "headers": {
          "Cache-Control": "no-store"
        },
        "json": {
          "detail": {
            "code": "AUTHZ_RESOURCE_NOT_CONFIGURABLE",
            "message": "待实施资源不能配置规范授权",
            "committed": false,
            "conflicts": [],
            "field_errors": [
              {
                "path": "/authorization/modules/purchase_analysis",
                "code": "RESOURCE_NOT_CONFIGURABLE",
                "message": "此资源当前只读"
              }
            ]
          }
        }
      },
      "assertions": [
        "username must_not_exist不落库。"
      ]
    },
