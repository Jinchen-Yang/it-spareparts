              "user_id": 41,
              "username": "alice",
              "expected_epoch": 7,
              "expected_resource_versions": {
                "sales_analysis": 3
              }
            }
          ],
          "operation": {
            "kind": "apply_template",
            "template_code": "sales_team",
            "expected_template_version": 3,
            "override_policy": "preserve"
          },
          "dry_run": false,
          "fingerprint": "19a94ea6c069ba97368a6df102da5ea8f84e60f47e0d2f497e6370017e8d78aa"
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "Cache-Control": "no-store"
        },
        "json": {
          "detail": {
            "code": "AUTHZ_PREVIEW_CONFLICT",
            "message": "预览后目标授权已变化，请重新预览",
            "committed": false,
            "conflicts": [
              {
                "kind": "epoch",
                "user_id": 41,
                "expected": 7,
                "actual": 8
              }
            ],
            "field_errors": []
          }
        }
      },
      "assertions": [
        "旧指纹不可自动重算或自动重试。",
        "全部targets零变化。"
      ]
    },
