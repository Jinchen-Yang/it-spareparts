    {
      "id": "bulk_late_target_epoch_conflict_no_partial_apply",
      "request": {
        "method": "POST",
        "path": "/api/accounts/bulk",
        "json": {
          "schema_version": 1,
          "catalog_version": "authz-s1-v1",
