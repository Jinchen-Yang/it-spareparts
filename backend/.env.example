# 本地裸跑（非 docker）时复制为 .env 并按需修改
DATABASE_URL=postgresql+psycopg://spareparts:spareparts@localhost:5432/spareparts
RAW_FILE_DIR=./data/raw
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-env
APP_PORT=8000
ENABLE_AGENT=false
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_APPROVED_MODELS=deepseek-v4-flash
LLM_EXTRA_BODY=
LLM_TRUST_ZONE=unknown
LLM_PRIVATE_BASE_URLS=
# Operator assertion only in v1; not network/Tailnet/TLS attestation. See #225 before production.
LLM_APPROVED_EXTERNAL_BASE_URLS=
AGENT_MODEL_CONTEXT_EGRESS_ENABLED=false
AGENT_ALLOW_UNATTESTED_PRIVATE_FOR_DEVELOPMENT=false
AGENT_ALLOW_LOOPBACK_HTTP=false
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
VISION_APPROVED_MODELS=qwen-vl-max
VISION_TRUST_ZONE=unknown
VISION_PRIVATE_BASE_URLS=
VISION_APPROVED_EXTERNAL_BASE_URLS=
# 部署级外发 kill-switch（预留），不是用户同意。v1 对 approved_external + customer_file 始终拒绝。
# 当前仅 dev/test 可用显式 unattested-private override；prod 会话/文件等 #225 attestation。
AGENT_EXTERNAL_FILE_EGRESS_ENABLED=false
