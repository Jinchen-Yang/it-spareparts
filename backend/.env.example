# 本地裸跑（非 docker）时复制为 .env 并按需修改
DATABASE_URL=postgresql+psycopg://spareparts:spareparts@localhost:5432/spareparts
RAW_FILE_DIR=./data/raw
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-env
MAINTENANCE_MANIFEST_ACTIVE_KEY_ID=dev-v1
MAINTENANCE_MANIFEST_ACTIVE_HMAC_KEY=change-me-maintenance-manifest-key-dev-v1
MAINTENANCE_MANIFEST_PREVIOUS_HMAC_KEYS_JSON={}
# 独立生产切换闸门：默认 false；迁移 manifest 的审批不会自动打开。
MAINTENANCE_CUTOVER_ENABLED=false
APP_PORT=8000
# 新功能独立 Beta；默认关闭，开通账号权限后再显式设 true
MAINTENANCE_BETA_ENABLED=false
REPLENISHMENT_BETA_ENABLED=false
# 维保展示板总闸（v1.23）：默认关＝展示板端点整组 404；发布脚本在灰度阶段翻开，
# 回滚只关这一个开关，不做 alembic downgrade。
MAINTENANCE_BOSS_DASHBOARD_ENABLED=false
# 回款计划导入写入闸门：默认关闭；具名 canary 验收完成后才由部署环境显式打开。
MAINTENANCE_COLLECTION_PLAN_APPLY_ENABLED=false
# 空 = 不限制项目（仅用于正式扩围）；首次授权 action 前必须设置唯一项目 UUID。
MAINTENANCE_COLLECTION_CANARY_PROJECT_ID=
