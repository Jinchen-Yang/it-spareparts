# 本地裸跑（非 docker）时复制为 .env 并按需修改
DATABASE_URL=postgresql+psycopg://spareparts:spareparts@localhost:5432/spareparts
RAW_FILE_DIR=./data/raw
ADMIN_PASSWORD=admin
SECRET_KEY=change-me-in-env
APP_PORT=8000
LLM_TRUST_ZONE=unknown
LLM_PRIVATE_BASE_URLS=
AGENT_MODEL_CONTEXT_EGRESS_ENABLED=false
# 客户文件内容进入 approved_external 主模型或独立视觉供应商的总开关；private 本地读取不需要。
AGENT_EXTERNAL_FILE_EGRESS_ENABLED=false
