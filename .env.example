# docker compose 启动时读取本目录的 .env
# 部署到生产服务器：把本文件复制为 .env 并替换全部密钥/密码

# 数据库密码(强随机, ≥ 16 位)
POSTGRES_PASSWORD=请改成强随机密码

# 管理员登录密码(强密码)
ADMIN_PASSWORD=请改成强密码

# Token 签名密钥(32 字节随机串, 可用 `openssl rand -hex 32` 生成)
SECRET_KEY=请改成32字节随机串

# 维保迁移 manifest 独立签名密钥（不得与 SECRET_KEY 相同）。轮换时更换 active key_id/key，
# 并把旧 key 以 JSON 映射保留在 PREVIOUS_HMAC_KEYS，供历史 manifest 验签。
MAINTENANCE_MANIFEST_ACTIVE_KEY_ID=prod-v1
MAINTENANCE_MANIFEST_ACTIVE_HMAC_KEY=请改成另一条32字节随机串
MAINTENANCE_MANIFEST_PREVIOUS_HMAC_KEYS_JSON={}
# 维保迁移只生成 dry-run / 对账 / 签名 manifest；默认不得消费 Beta 删除墓碑或切换成本库存口径。
# 仅在独立生产验收和正式变更审批完成后，才由运维显式改为 true。
MAINTENANCE_CUTOVER_ENABLED=false

# 新功能灰度总闸：默认均关闭；先在权限中心加入试用账号，再逐项开启。
MAINTENANCE_BETA_ENABLED=false
REPLENISHMENT_BETA_ENABLED=false

# 运行模式: dev | prod
# prod 模式下若上面三个仍是默认弱值, 应用拒绝启动(安全护栏)
ENVIRONMENT=prod

# 前端回环端口（只供宿主机反向代理、健康探针和 SSH 隧道使用）
# 生产用户必须通过正式域名的 HTTPS 入口访问，禁止把应用开放到公网 8080。
# Issue #178 的旧公网 8080 仅允许由独立 Caddy 做 GET/HEAD 308 纯跳转。
FRONTEND_PORT=8080
APP_PORT=8000

# ===== AI 只读 Query Broker（默认关闭）=====
# 只有独立 agent_reader、三角色/FORCE-RLS/security-barrier views 全部完成并
# 通过 live self-check 后才可开启。不得复用 DATABASE_URL/app 账号。
ENABLE_TEXT2SQL=false
AGENT_DATABASE_URL=

# ===== 构建加速(仅 docker build 时用) =====
# 默认上游官方源; 大陆服务器换镜像避免 pip/npm 拉包超时:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# ===== 二期 AI 定价助手（LLM）=====
# 默认对接 DeepSeek(国产, 大陆直连): https://platform.deepseek.com 申请密钥
# 也可换任何 OpenAI 兼容端点(通义/Kimi/GLM): 改 BASE_URL + MODEL 即可
# 密钥只放服务器 .env, 切勿提交进代码仓库
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# v4 为混合思考模型, 留空 = 默认非思考模式(快/省/够用); 设 {} = 不传额外参数(恢复思考);
# 换其他端点按其文档改(如 Qwen: {"enable_thinking": false})
LLM_EXTRA_BODY=

# ===== 三期 视觉识别(图片/扫描件 → 文字, 整机配置拆解用) =====
# 默认通义 Qwen-VL(阿里 DashScope): https://bailian.console.aliyun.com 申请密钥
# 留空 = 不启用, 图片/扫描件返回降级提示, 文字版 Word/Excel/PDF/txt 不受影响
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
