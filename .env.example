# docker compose 启动时读取本目录的 .env
# 部署到生产服务器：把本文件复制为 .env 并替换全部密钥/密码

# 数据库密码(强随机, ≥ 16 位)
POSTGRES_PASSWORD=请改成强随机密码

# 管理员登录密码(强密码)
ADMIN_PASSWORD=请改成强密码

# Token 签名密钥(32 字节随机串, 可用 `openssl rand -hex 32` 生成)
SECRET_KEY=请改成32字节随机串

# 运行模式: dev | prod
# prod 模式下若上面三个仍是默认弱值, 应用拒绝启动(安全护栏)
ENVIRONMENT=prod

# 前端端口(浏览器访问 http://<服务器IP>:<这个端口>)
FRONTEND_PORT=8080
APP_PORT=8000

# ===== 二期 AI 定价助手（LLM）=====
# 默认对接 DeepSeek(国产, 大陆直连): https://platform.deepseek.com 申请密钥
# 也可换任何 OpenAI 兼容端点(通义/Kimi/GLM): 改 BASE_URL + MODEL 即可
# 密钥只放服务器 .env, 切勿提交进代码仓库
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# v4 为混合思考模型, 留空 = 默认非思考模式(快/省/够用); 设 {} = 不传额外参数(恢复思考);
# 换其他端点按其文档改(如 Qwen: {"enable_thinking": false})
LLM_EXTRA_BODY=
