# docker compose 启动时读取本目录的 .env
# 部署到生产服务器：把本文件复制为 .env 并替换全部密钥/密码

# 数据库密码(强随机, ≥ 16 位)
POSTGRES_PASSWORD=请改成强随机密码

# 管理员登录密码(强密码)
ADMIN_PASSWORD=请改成强密码

# Token 签名密钥(32 字节随机串, 可用 `openssl rand -hex 32` 生成)
SECRET_KEY=请改成32字节随机串

# 运行模式: dev | prod
# prod 模式下若上面三个仍是默认弱值, 应用拒绝启动(安全护栏)
ENVIRONMENT=prod

# 前端回环端口（只供宿主机反向代理、健康探针和 SSH 隧道使用）
# 生产用户必须通过正式域名的 HTTPS 入口访问，禁止把应用开放到公网 8080。
# Issue #178 的旧公网 8080 仅允许由独立 Caddy 做 GET/HEAD 308 纯跳转。
FRONTEND_PORT=8080
APP_PORT=8000

# ===== 构建加速(仅 docker build 时用) =====
# 默认上游官方源; 大陆服务器换镜像避免 pip/npm 拉包超时:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# ===== 二期 AI 定价助手（LLM）=====
# 默认对接 DeepSeek(国产, 大陆直连): https://platform.deepseek.com 申请密钥
# 端点/model/options 必须分别进入精确准入配置；只改 BASE_URL + MODEL 不会获得出网权限
# 密钥只放服务器 .env, 切勿提交进代码仓库
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_APPROVED_MODELS=deepseek-v4-flash
ENABLE_AGENT=false
# 模型目标信任区：unknown | private(Tailnet/GPU0) | approved_external(仅非客户文件的已批准目标)
# unknown 为安全默认；必须再显式打开下一项，工具结果才可进入模型上下文。
LLM_TRUST_ZONE=unknown
# private / approved_external 都必须配置精确 HTTPS origin 白名单（不带路径/query/凭据）。
# 示例：LLM_BASE_URL=https://gpu0.example-tailnet.ts.net:8000/v1 时填：
# v1 only treats this as an operator assertion, not proof of Tailnet/network/TLS identity.
# Keep ENABLE_AGENT=false in production until #225 adds verifiable private endpoint identity.
# LLM_PRIVATE_BASE_URLS=https://gpu0.example-tailnet.ts.net:8000
LLM_PRIVATE_BASE_URLS=
LLM_APPROVED_EXTERNAL_BASE_URLS=
AGENT_MODEL_CONTEXT_EGRESS_ENABLED=false
# 仅 dev/test provider harness；prod 即使设 true 也拒绝，不能替代 #225 identity attestation。
AGENT_ALLOW_UNATTESTED_PRIVATE_FOR_DEVELOPMENT=false
# 仅本地 dev 调试可显式允许 http://localhost/127.0.0.1；生产始终拒绝 HTTP。
AGENT_ALLOW_LOOPBACK_HTTP=false
# 留空 = 固定受控 profile「thinking disabled」；仅允许该 profile、{"enable_thinking":false}
# 或 {}。{} 只是明确不传额外参数，不保证供应商关闭隐藏思考；任意其它 key/value 拒绝出网。
LLM_EXTRA_BODY=

# ===== 三期 视觉识别(图片/扫描件 → 文字, 整机配置拆解用) =====
# 默认通义 Qwen-VL(阿里 DashScope): https://bailian.console.aliyun.com 申请密钥
# 留空 = 不启用, 图片/扫描件返回降级提示, 文字版 Word/Excel/PDF/txt 不受影响
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
VISION_APPROVED_MODELS=qwen-vl-max
# Vision 使用独立信任区和独立精确 origin 白名单，不能继承主模型配置。
VISION_TRUST_ZONE=unknown
VISION_PRIVATE_BASE_URLS=
VISION_APPROVED_EXTERNAL_BASE_URLS=
# 部署级客户文件外发 kill-switch（预留），不代表当前用户同意。
# v1 未建立可验证的逐用户同意/撤销记录：approved_external 主 LLM 与 Vision 即使设 true 也拒绝客户数据。
# 当前仅 dev/test harness 可用 private + override；prod 会话/文件等待 #225 attestation。
AGENT_EXTERNAL_FILE_EGRESS_ENABLED=false
