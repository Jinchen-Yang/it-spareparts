{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".ai/AI_WORKFLOW.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git merge": "ask",
      "git merge *": "ask",
      "git push -f *": "ask",
      "git push --force*": "ask",
      "gh pr merge": "ask",
      "gh pr merge *": "ask",
      ".deploy/*": "ask",
      "./.deploy/*": "ask",
      "bash .deploy/*": "ask",
      "sh .deploy/*": "ask",
      "node .deploy/*": "ask",
      "python .deploy/*": "ask",
      "python3 .deploy/*": "ask",
      "ssh": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "sudo *": "ask"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow"
  }
}
